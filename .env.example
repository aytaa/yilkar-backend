# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=yilkar
PG_USER=yilkar
PG_PASSWORD=yilkar123

# MongoDB
MONGO_URI=mongodb://localhost:27017/yilkar

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=yilkar-api
MQTT_PASSWORD=yilkar-api-secret
MQTT_CLIENT_ID=yilkar-backend

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Default admin
ADMIN_EMAIL=admin@yilkar.com.tr
ADMIN_PASSWORD=Admin1234!
